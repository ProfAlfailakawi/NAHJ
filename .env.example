# ── NAHJ — إعدادات التشغيل ────────────────────────────────────────────────────

# مسار قاعدة البيانات (SQLite). الافتراضي: ./var/nahj.sqlite
# في Cloud Run استخدم قرصاً دائماً؛ القرص المؤقت يعني فقدان الحالة عند كل نشر.
NAHJ_DATABASE_PATH=./var/nahj.sqlite

# حساب المشغّل الأول — اختياري.
# اتركهما فارغين وأنشئ الحساب من المتصفح عند أول تشغيل (شاشة التهيئة تُعرض تلقائياً
# ما دام لا يوجد أي حساب، وتُقفل نهائياً بمجرد إنشائه).
# اضبطهما فقط إذا أردت تهيئة آلية بلا تدخل بشري (نشر تلقائي مثلاً).
# كلمة المرور: 12 محرفاً على الأقل، حروف وأرقام.
NAHJ_ADMIN_EMAIL=
NAHJ_ADMIN_PASSWORD=
NAHJ_ADMIN_NAME=مشرف النظام

# الإنتاج: يفعّل كوكي Secure ويقدّم الحزمة المبنية بدل خادم التطوير.
NODE_ENV=production

# مفتاح Gemini لمسارات التوليف والمحاكاة. بدونه تعمل المسارات بمنطقها الحتمي فقط.
GEMINI_API_KEY=

# عنوان الاستضافة. تحقنه AI Studio تلقائياً بعنوان خدمة Cloud Run.
# يُستعمل للروابط المرجعية وعناوين العودة.
APP_URL=
