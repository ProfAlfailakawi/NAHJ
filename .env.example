##############################################################################
# نهج — إعداد التشغيل الكامل
#
# كل متغيّر هنا له مستهلك حقيقي في المصدر. للتحقق:  npm run verify:env
##############################################################################


##############################################################################
# القسم ١ — التخزين الدائم (الأهم)
##############################################################################

NODE_ENV=production

# مسار ملف قاعدة البيانات. الافتراضي: ./var/nahj.sqlite
#
# ⚠ هذا أخطر إعداد في نهج. الحالة كلها — المهارات المرقّاة، الموافقات، سجل الأثر،
#   الحسابات والجلسات — في هذا الملف. على قرص مؤقت (وهو الافتراضي في Cloud Run)
#   يُمحى كل شيء مع كل نشر، فيعود البرنامج نموذج عرض.
#
#   Cloud Run: اربط وحدة تخزين دائمة (Cloud Storage FUSE أو Filestore) ووجّه
#              المسار إليها. نسخة واحدة فقط من الخدمة — SQLite لا يُشارَك بين نسخ.
#   VM/خادم:   أي مسار على قرص دائم.
NAHJ_DATABASE_PATH=/var/nahj/nahj.sqlite

# بديل: مجلد البيانات، ويُشتق منه المسار أعلاه (يُتجاهَل حين NAHJ_DATABASE_PATH مضبوط).
NAHJ_DATA_DIR=


##############################################################################
# القسم ٢ — حساب المشغّل الأول (اختياري)
#
# اتركهما فارغين وأنشئ الحساب من المتصفح: شاشة التهيئة تُعرض تلقائياً ما دام لا
# يوجد أي حساب، وتُقفل نهائياً بمجرد إنشاء أول حساب.
#
# اضبطهما فقط إن أردت تهيئة آلية بلا تدخّل بشري (نشر أوتوماتيكي).
# كلمة المرور: 12 محرفاً على الأقل، حروف وأرقام.
##############################################################################

NAHJ_ADMIN_EMAIL=
NAHJ_ADMIN_PASSWORD=
NAHJ_ADMIN_NAME=مشرف النظام


##############################################################################
# القسم ٣ — البيئة التجريبية
#
# مفعّلة افتراضياً. يدخلها الزائر بنفسه من شاشة الدخول، فيحصل على نسخة اصطناعية
# معزولة في الذاكرة — لا تُقرأ ولا تُكتب أي بيانات مؤسسة، ولا شيء منها يصل القرص.
# اضبطه false في نشرٍ يجب ألّا يعرض بيئة تجريبية إطلاقاً.
##############################################################################

NAHJ_DEMO_ENABLED=true


##############################################################################
# القسم ٤ — الذكاء الاصطناعي (اختياري)
#
# بدون المفتاح تعمل مسارات التوليف والمحاكاة بمنطقها الحتمي فقط — لا تتعطّل.
##############################################################################

GEMINI_API_KEY=


##############################################################################
# القسم ٥ — تطوير محلي فقط
##############################################################################

DISABLE_HMR=false


##############################################################################
# ملاحظة على APP_URL
#
# تحقنه AI Studio تلقائياً في بيئة التشغيل، لكن **لا يقرأه أي كود في نهج اليوم**.
# تُرك موثّقاً هنا لئلا يبدو غيابه خطأً، لا لأنه مطلوب. ضبطه أو تركه لا يغيّر شيئاً.
##############################################################################

# --- الترخيص والاشتراك -------------------------------------------------------
# بريد مالك المنصة. يُرقّى صاحبه تلقائياً إلى دور owner عند الإقلاع.
# غيابه ⇒ يُرقّى أقدم حساب، وهو حساب من هيّأ النظام. راجع BILLING.md
NAHJ_OWNER_EMAIL=

# طول التجربة التلقائية بالأيام لنشرٍ لا اشتراك فيه بعد (افتراضياً 30).
NAHJ_TRIAL_DAYS=30


##############################################################################
# القسم ٦ — بوابة الدفع (التحصيل الإلكتروني)
#
# اتركها فارغة ⇒ لا بوابة: تُسدَّد الفواتير خارج المنصة ويُسجّل المالك الدفعة
# بمرجعها، وتقول الشاشة ذلك صراحةً ولا تعرض زرّ دفع.
#
# الأربعة التالية **كلها** لازمة لتعمل البوابة. ونصفُ إعدادٍ لا يُحصّل ديناراً،
# لذلك يرفض verify:env النشرَ عليه. الخطوات كاملة في PAYMENTS.md
##############################################################################

# myfatoorah | tap | manual
NAHJ_PAYMENT_PROVIDER=

# مفتاح المزوّد. مفتاح اختبارٍ لبيئة الاختبار، ومفتاح إنتاجٍ للحيّة.
NAHJ_PAYMENT_API_KEY=

# سرّ توقيع الإشعارات — نفسه المسجَّل عند المزوّد.  openssl rand -hex 32
NAHJ_PAYMENT_WEBHOOK_SECRET=

# عنوان النشر كما يراه المزوّد. https إلزاماً — لا يُرسَل إشعار إلى غير المشفّر.
# ويُشتق منه عنوان الإشعار: <العنوان>/api/payments/webhook/<المزوّد>
NAHJ_PUBLIC_URL=

# بريد التواصل التجاري الظاهر في صفحة /pricing (زر «تواصل معنا»).
# فارغٌ = لا يظهر رابط تواصل، بدل رابطٍ يقود إلى لا شيء.
NAHJ_CONTACT_EMAIL=

# الاسم القانوني لمشغّل المنصة كما يظهر في /terms و/privacy وتذييل الصفحات.
# فارغٌ = «مشغّل منصة نهج».
NAHJ_LEGAL_NAME=

# رقم واتساب للتواصل التجاري بالصيغة الدولية (مثل 96550000000) — يظهر بجوار نموذج «اطلب عرضاً».
NAHJ_CONTACT_WHATSAPP=

# أقصى عدد لصناديق العرض المتزامنة في الذاكرة (300 افتراضاً). يُزاح الأقدم عند بلوغه.
NAHJ_DEMO_MAX_SANDBOXES=

# off في نشر كل عميل: الجذر يفتح التطبيق مباشرة، ولا صفحة تسويق ولا نموذج «اطلب عرضاً»
# ولا فهرسة. يبقى مفعّلاً (فارغاً) في نشرك أنت — الموقع الذي تسوّق منه.
NAHJ_MARKETING=

# test (الافتراضي) | live — «live» تُحصّل مالاً حقيقياً.
NAHJ_PAYMENT_ENV=test

# اختياري: عنوان API غير القياسي (للاختبار المحلي أو بيئة خاصة).
NAHJ_PAYMENT_API_BASE=


##############################################################################
# القسم ٧ — النسخ الاحتياطي
#
# النسخة تُكتب بـVACUUM INTO فتكون قاعدةً سليمة وهي قيد الاستعمال.
# ⚠ ضع المجلد على قرصٍ غير قرص القاعدة — نسخةٌ بجوار الأصل تضيع معه.
# التفاصيل والاستعادة في BACKUP.md
##############################################################################

# كل كم ساعة تُكتب نسخة (0 = تعطيل الدوري؛ النسخ اليدوي من لوحة المالك يبقى).
NAHJ_BACKUP_HOURS=24

# كم نسخة تُستبقى — الأقدم يُحذف أولاً.
NAHJ_BACKUP_KEEP=14

# مجلد النسخ. الافتراضي: backups/ بجوار ملف القاعدة.
NAHJ_BACKUP_DIR=


##############################################################################
# القسم ٨ — الإشعارات (اختياري)
#
# اتركها فارغة ⇒ لا بريد: الأحداث تُسجَّل في لوحة المالك ولا تُرسل، والتبليغ يدوي.
# ولا يرسل نهج كلمة مرور ولا رابط دخول في بريد إطلاقاً — البريد قناة تُخزَّن
# وتُعاد توجيهاً وتُقرأ من هاتف ضائع. الكلمة المؤقتة تُسلَّم باليد.
##############################################################################

# resend | sendgrid | webhook  (اتركه فارغاً لتعطيل البريد)
NAHJ_MAIL_PROVIDER=

# مفتاح المزوّد (لـresend أو sendgrid).
NAHJ_MAIL_API_KEY=

# عنوان المُرسِل — يجب أن يكون نطاقاً موثّقاً عند المزوّد.
NAHJ_MAIL_FROM=

# بديلٌ عن البريد: عنوانٌ يستقبل الإشعار JSON فتوصّله المؤسسة بنظامها
# (واتساب، سلاك، بوابة داخلية). يُستعمل حين NAHJ_MAIL_PROVIDER=webhook
NAHJ_MAIL_WEBHOOK_URL=

# كل كم دقيقة يُفرَغ الطابور وتُحسب التذكيرات (افتراضياً 15).
NAHJ_MAIL_INTERVAL_MINUTES=15
